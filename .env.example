# CineMatch Environment Variables

# Backend Port (default 5000)
PORT=5000
FLASK_DEBUG=False

# Optional: TMDB API Key for live watch provider & metadata synchronization
# Get your free key at: https://www.themoviedb.org/settings/api
# If not provided, CineMatch runs completely offline using its curated pre-seeded dataset!
TMDB_API_KEY=

# Optional: Frontend API URL (if frontend is hosted on a separate domain from backend)
# VITE_API_URL=http://127.0.0.1:5000/api
